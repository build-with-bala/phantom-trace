# Phantom Trace - Environment Variables

# AI Provider API Keys (optional - tool works without AI features)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# Ollama (local models - no API key needed)
OLLAMA_BASE_URL=http://localhost:11434

# Proxy Settings
TOR_PROXY=socks5://127.0.0.1:9050
HTTP_PROXY=
HTTPS_PROXY=
